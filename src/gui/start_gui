    def set_new_granularity_limits(self, prev_granularity):
        if prev_granularity == 0:
            minChannel = self.__dataMonitorMinSelection
            maxChannel = self.__dataMonitorMaxSelection
        elif prev_granularity == 1:
            minChannel = self.__dataMonitorMinSelection * 64 
            maxChannel = self.__dataMonitorMaxSelection * 64 + 64
        elif prev_granularity == 2:
            minChannel = self.__dataMonitorMinSelection * 1024 
            maxChannel = self.__dataMonitorMaxSelection * 1024 + 1024
        
        if maxChannel > self.__dataMonitorMaxSettable:
            maxChannel = self.__dataMonitorMaxSettable
        if minChannel < self.__dataMonitorMinSettable:
            minChannel = self.__dataMonitorMinSettable        

        if  self.__dataMonitorPlotBy == 0:
            self.__dataMonitorMinSelection = minChannel
            self.__dataMonitorMaxSelection = maxChannel
        elif  self.__dataMonitorPlotBy == 1:
            self.__dataMonitorMinSelection = int(minChannel / 64)
            self.__dataMonitorMaxSelection = int(maxChannel / 64)
        elif  self.__dataMonitorPlotBy == 2:
            self.__dataMonitorMinSelection = int(minChannel / 1024)
