            return
        
        if not self.is_daqd_running():   
            self.show_error_dialog("The 'daqd' communication server is not running. Please start it to continue.")
            return
       
        if not os.path.exists(self.__workingFolder + "bias_settings.tsv"):
            self.show_error_dialog("Save bias voltage settings to continue.")
            return
            
        if not os.path.exists(self.__workingFolder + "disc_settings.tsv"):
            self.show_error_dialog("Save threshold settings to continue.")
            return

        if self.builder.get_object("acqFileEntry").get_text() == "":
            self.show_error_dialog("Please enter a name for the output file.")
            return

        outFile = self.__workingFolder+self.builder.get_object("acqFileEntry").get_text()

        self.__isProcessSipmAcquisition = True

        if outFile.endswith('.rawf'):
            fileName, ext = os.path.splitext(fileName)

