    def _render_thread_worker(self):
        """Background thread: only the slow SaveAs PNG lives here."""
        try:
            with tempfile.NamedTemporaryFile(suffix=".png", delete=False) as f:
                tmppath = f.name

            devnull = open(os.devnull, 'w')
            old_stdout = os.dup(1)
            old_stderr = os.dup(2)
            os.dup2(devnull.fileno(), 1)
            os.dup2(devnull.fileno(), 2)

            self.rootCanvas.SaveAs(tmppath)

            os.dup2(old_stdout, 1)
            os.dup2(old_stderr, 2)
            os.close(old_stdout)
            os.close(old_stderr)
            devnull.close()

            GLib.idle_add(self._update_gtk_image, tmppath)
        except Exception as e:
            print(f"Render thread error: {e}")
            self._render_thread_running = False


    def _update_gtk_image(self, tmppath):
        """GTK main thread: load pixbuf and refresh widget."""
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file(tmppath)
            self.rootImage.set_from_pixbuf(pixbuf)
            self.rootImage.queue_draw()
            os.unlink(tmppath)
        except Exception as e:
            print(f"GTK image update error: {e}")
        finally:
            self._render_thread_running = False
        return False 
    

