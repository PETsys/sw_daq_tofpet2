    def on_executeStopButton_clicked(self, button):
        if self.__process is None:
            return True

        message = "Stop data acquisition?" if self.__isProcessSipmAcquisition else "Stop the process?"

        if self.show_confirmation_dialog("", message, self.processWindow):
            if self.__isProcessSipmAcquisition:
                with open("/tmp/aquisition_end_fifo", "w") as fifo:
                    fifo.write("stop")
            else:
                os.killpg(os.getpgid(self.__process.pid), signal.SIGTERM)
            self.__usedStopButton = True

        return True


