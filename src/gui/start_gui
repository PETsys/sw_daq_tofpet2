    def start_data_monitoring(self):
        if self.__dataMonitorSourceId is not None:
            GLib.source_remove(self.__dataMonitorSourceId) 
        
        self.__dataMonitorSourceId = GLib.timeout_add(
            self.__dataMonitorRefreshTime * 1000,
            self.update_data_monitoring_plot
        )


    def _on_draw_root(self, widget, cr):
        if self._rootPixbuf is None:
            return
        alloc = widget.get_allocation()
        scaled = self._rootPixbuf.scale_simple(
            alloc.width, alloc.height, GdkPixbuf.InterpType.BILINEAR
        )
        Gdk.cairo_set_source_pixbuf(cr, scaled, 0, 0)
        cr.paint()

    def _fill_energy_histogram_from_array(self, counts_array):
        self.rootHistEnergy.Reset()
        for i, c in enumerate(counts_array):
            self.rootHistEnergy.SetBinContent(i + 1, float(c))
    

    def _fill_counts_histogram_from_array(self, granularity, counts_array):
        hist = self.hist_map[granularity]
        hist.Reset()
        counts_for_fill = counts_array
        if granularity == 1:
            counts_for_fill = counts_array.reshape(-1, 64).sum(axis=1)
        if granularity == 2:
            counts_for_fill = counts_array.reshape(-1, 1024).sum(axis=1)
        arr = counts_for_fill.astype(np.float64)
        root_buf = np.frombuffer(hist.GetArray(), dtype=np.float64)
        root_buf[1:len(arr)+1] = arr


