    def update_data_monitoring_plot(self, isFirstCall = False):

        t0 = time.time()
      
        self.__dataMonitorMinSettable, self.__dataMonitorMaxSettable, channel_data_array = self.__dataMonitorReader.read_counts_for_all_channels() 

        if isFirstCall:
            self.__dataMonitorMinSelection = self.__dataMonitorMinSettable
            self.__dataMonitorMaxSelection = self.__dataMonitorMaxSettable
            self.builder.get_object("dataMonitoringSpinButtonMin").set_range(self.__dataMonitorMinSelection, self.__dataMonitorMaxSelection)
            self.builder.get_object("dataMonitoringSpinButtonMin").set_value(self.__dataMonitorMinSelection)
            self.builder.get_object("dataMonitoringSpinButtonMax").set_range(self.__dataMonitorMinSelection, self.__dataMonitorMaxSelection)
            self.builder.get_object("dataMonitoringSpinButtonMax").set_value(self.__dataMonitorMaxSelection)
            self.builder.get_object("dataMonitoringSpinButtonMin").set_sensitive(False)
            self.builder.get_object("dataMonitoringSpinButtonMax").set_sensitive(False)

        self.__dataMonitorMinSelection = int(self.builder.get_object("dataMonitoringSpinButtonMin").get_value()) 
        self.__dataMonitorMaxSelection = int(self.builder.get_object("dataMonitoringSpinButtonMax").get_value()) 

        
        energy_data_array = self.__dataMonitorReader.read_energy_for_channel_range(self.__dataMonitorMinSelection, self.__dataMonitorMaxSelection)
       
        edges        = self.__dataMonitorReader.edges
        centers      = self.__dataMonitorReader.bin_centers
      
        # --- Statistics ---
        buf = self.builder.get_object("dataMonitoringTextView").get_buffer()
        if energy_data_array.sum() > 0:
            peak_bin    = int(energy_data_array.argmax())
            peak_energy = centers[peak_bin]
            peak_counts = int(energy_data_array[peak_bin])
            weights     = energy_data_array.astype(np.float64)
            mean_energy = float(np.average(centers, weights=weights))
            variance    = float(np.average((centers - mean_energy)**2, weights=weights))
            std_energy  = float(np.sqrt(variance))
            nonzero     = np.where(energy_data_array > 0)[0]
            emin        = edges[nonzero[0]]
            emax        = edges[nonzero[-1] + 1]
        else:
            peak_energy = peak_counts = mean_energy = std_energy = 0.0
            emin, emax  = edges[0], edges[-1]

        sep  = "─" * 32 + "\n"
        text = (
            f"{'CHANNEL STATISTICS':^32}\n{sep}"
            f"  Channel ID     : {self.selected_channels}\n"
            f"  Total counts   : {energy_data_array.sum()}\n{sep}"
            f"  Peak energy    : {peak_energy:.2f}\n"
            f"  Peak counts    : {peak_counts:,}\n"
            f"  Mean energy    : {mean_energy:.2f}\n"
            f"  Std dev        : {std_energy:.2f}\n{sep}"
            f"  Energy range   : [{emin:.2f}, {emax:.2f}]\n"
            f"  Num bins       : {self.__dataMonitorReader.nEnergyBins}\n"
            f"  Bin width      : {(edges[1]-edges[0]):.3f}\n{sep}"
        )
        buf.set_text(text)
    
        # --- Plot ---
        self.rootCanvas.cd()
       

        if self.__dataMonitorPlotType == 1:
            self._fill_energy_histogram_from_array(energy_data_array)
            self.setup_plot_for_spectra(emax)
            if self.__dataMonitoringSetLogY:
                self.rootCanvas.SetLogy(1)
                #self.rootHistEnergy.SetMinimum(0.5)
            else:
                self.rootCanvas.SetLogy(0)
                #self.rootHistEnergy.SetMinimum(0)

            if self.__dataMonitoringSetGrid:
                self.rootCanvas.SetGrid(1, 1) 
            else:
                self.rootCanvas.SetGrid(0, 0) 
            
            self.rootHistEnergy.Draw("HIST")

        elif self.__dataMonitorPlotType == 0:
            self._fill_counts_histogram_from_array(self.__dataMonitorPlotBy, channel_data_array)   
            self.setup_plot_for_count_dist()
            if self.__dataMonitoringSetLogY:
                self.rootCanvas.SetLogy(1)
                #self.rootHistCounts.SetMinimum(0.5)
            else:
                self.rootCanvas.SetLogy(0)
                #self.rootHistCounts.SetMinimum(0)

            if self.__dataMonitoringSetGrid:
                self.rootCanvas.SetGrid(1, 1) 
            else:
                self.rootCanvas.SetGrid(0, 0) 
            
            self.hist_map[self.__dataMonitorPlotBy].Draw("HIST")    
        self.rootCanvas.Update()
        if not getattr(self, '_render_thread_running', False):
            self._render_thread_running = True
            threading.Thread(target=self._render_thread_worker, daemon=True).start()

        #self._render_canvas_to_gtk()
        print(f"block 1 free gtk loop took  took {(time.time() - t0)*1000:.1f} ms")
        return True    



